@echo off
rem ============================================================================
rem  Кристаллы Раздора — GUI-раннер прогонов ботов.
rem  Двойной клик по этому файлу запускает окно с параметрами прогона.
rem  Первый запуск собирает fat-jar (может занять минуту); дальше — сразу.
rem ============================================================================
chcp 65001 >nul
cd /d "%~dp0"

rem Fat-jar теперь собирается модулем gui (разделено 14.08.2026), не корнем.
set JAR=gui\target\kelium-runner.jar

if not exist "%JAR%" (
    echo Собираю программу (первый запуск, подождите)...
    call mvn -q -DskipTests package
    if errorlevel 1 (
        echo.
        echo ОШИБКА сборки. Убедитесь, что установлены Java 21+ и Maven.
        pause
        exit /b 1
    )
)

echo Запускаю раннер...
java -jar "%JAR%"
if errorlevel 1 (
    echo.
    echo Программа завершилась с ошибкой.
    pause
)
