@echo off
rem ============================================================================
rem  Пересобрать КАРТИНКИ СПРАВОЧНИКА (Справка → Справочник, клавиша F1).
rem
rem  Картинки снимаются с самого приложения: программа играет партию, ставит
rem  приборы на нужный кадр и рисует их в PNG. Поэтому они не могут разойтись
rem  с тем, что видно на экране — но после правок вида их надо пересобрать.
rem
rem  Куда кладёт: data\help\  (по именам разделов справочника)
rem  Заодно пишет reports\КАРТЫ-БЕЗ-ОПИСАНИЯ.md — список для дизайнера.
rem ============================================================================
chcp 65001 >nul
cd /d "%~dp0"

set JAR=target\kelium-runner.jar

if not exist "%JAR%" (
    echo Собираю программу (первый запуск, подождите)...
    call mvn -q -DskipTests package
    if errorlevel 1 (
        echo.
        echo ОШИБКА сборки. Убедитесь, что установлены Java 21+ и Maven.
        pause
        exit /b 1
    )
)

echo Собираю картинки справочника...
java -cp "%JAR%" kelium.gui.replay2.HelpShots
if errorlevel 1 (
    echo.
    echo ОШИБКА: картинки собрать не удалось.
    pause
    exit /b 1
)
echo.
echo Готово.
pause
