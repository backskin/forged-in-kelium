# СЦЕНАРИЙ: 2 игрока. v1/v2 — диктовка дизайнера (2026-08-10); v3 — эксперимент Клода.
# Формат: shape = ряды сверху вниз, {offset: отступ слева в колонках, count: гексов};
# special = особые гексы (row, col), колонки АБСОЛЮТНЫЕ по общей сетке.
# Дизайнер диктует «ряд-номер гекса В РЯДУ»: col = offset + номер.
# neutrals = слой нейтральных зданий ПОВЕРХ любого гекса (их может быть несколько
# на гексе); corners — углы касания (1 = север, по часовой 1..6).
meta:
  id: 1.0.0
  type: scenario
  players: 2
  _needs_verification: true

scenarios:
  # ===== ВАРИАНТ 1 (диктовка, ПОДТВЕРЖДЁН дизайнером) =====
  - id: field_2p_v1
    shape:
      - {offset: 1, count: 3}   # ряд 1: колонки 2-4
      - {offset: 1, count: 4}   # ряд 2: колонки 2-5
      - {offset: 0, count: 5}   # ряд 3: колонки 1-5
      - {offset: 1, count: 4}   # ряд 4: колонки 2-5
      - {offset: 1, count: 3}   # ряд 5: колонки 2-4
    special:
      - {row: 1, col: 3, content: container, count: 1}        # 1-2
      - {row: 1, col: 4, content: container, count: 1}        # 1-3
      - {row: 2, col: 3, content: kelium_tile}                # 2-2 обычная грядка
      - {row: 2, col: 4, content: container, count: 1}        # 2-3
      - {row: 2, col: 5, content: spawn_start}                # 2-4 стартовая грядка
      - {row: 3, col: 1, content: player_start, seat: 0}      # 3-1 игрок 1
      - {row: 3, col: 5, content: player_start, seat: 1}      # 3-5 игрок 2
      - {row: 4, col: 2, content: spawn_start}                # 4-1 стартовая грядка
      - {row: 4, col: 3, content: container, count: 1}        # 4-2
      - {row: 4, col: 4, content: kelium_tile}                # 4-3 обычная грядка
      - {row: 5, col: 2, content: container, count: 1}        # 5-1
      - {row: 5, col: 3, content: container, count: 1}        # 5-2
    neutrals:
      - {row: 1, col: 3, size: small, corners: [5, 6]}        # 1-2
      - {row: 2, col: 2, size: small, corners: [2, 3]}        # 2-1
      - {row: 2, col: 4, size: small, corners: [5, 6]}        # 2-3
      - {row: 4, col: 3, size: small, corners: [2, 3]}        # 4-2
      - {row: 4, col: 5, size: small, corners: [5, 6]}        # 4-4
      - {row: 5, col: 3, size: small, corners: [2, 3]}        # 5-2

  # ===== ВАРИАНТ 2 (диктовка 2026-08-10) =====
  # Отступы дизайнера [1,0,1,0,1] прочитаны как полушаги лесенки: ряды 2/4 —
  # самые широкие (кол. 2-5), нечётные утоплены на полгекса. Проверка: игроки,
  # грядки и нейтралы (с углами) зеркалятся на 180° — сходится ИДЕАЛЬНО.
  - id: field_2p_v2
    shape:
      - {offset: 1, count: 3}   # ряд 1: колонки 2-4
      - {offset: 1, count: 4}   # ряд 2: колонки 2-5
      - {offset: 1, count: 3}   # ряд 3: колонки 2-4
      - {offset: 1, count: 4}   # ряд 4: колонки 2-5
      - {offset: 1, count: 3}   # ряд 5: колонки 2-4
    special:
      - {row: 1, col: 2, content: container, count: 1}        # 1-1
      - {row: 1, col: 3, content: container, count: 1}        # 1-2
      - {row: 1, col: 4, content: spawn_start}                # 1-3
      - {row: 2, col: 2, content: container, count: 1}        # 2-1
      - {row: 2, col: 3, content: container, count: 1}        # 2-2
      - {row: 2, col: 5, content: player_start, seat: 0}      # 2-4 игрок 1
      - {row: 3, col: 3, content: kelium_tile, modifier: "x2"} # 3-2 обычная грядка x2
      - {row: 4, col: 2, content: player_start, seat: 1}      # 4-1 игрок 2
      - {row: 4, col: 4, content: container, count: 1}        # 4-3
      - {row: 4, col: 5, content: container, count: 1}        # 4-4
      - {row: 5, col: 2, content: spawn_start}                # 5-1
      - {row: 5, col: 3, content: container, count: 1}        # 5-2
      - {row: 5, col: 4, content: container, count: 1}        # 5-3
    neutrals:
      - {row: 2, col: 3, size: big, corners: [5, 6, 1]}       # 2-2 двойное 5-1
      - {row: 2, col: 4, size: small, corners: [5, 6]}        # 2-3
      - {row: 3, col: 2, size: small, corners: [2, 3]}        # 3-1
      - {row: 3, col: 4, size: small, corners: [5, 6]}        # 3-3
      - {row: 4, col: 3, size: small, corners: [2, 3]}        # 4-2
      - {row: 4, col: 4, size: big, corners: [2, 3, 4]}       # 4-3 двойное 2-4

  # ===== ВАРИАНТ 3 «Кольцо» (эксперимент Клода — НЕ раскладка дизайнера) =====
  # Идея: дыра в центре -> бой и логистика идут ПО КОЛЬЦУ; по обе стороны дыры
  # СВОБОДНЫЕ дорожки (правило «хотя бы один открытый путь между игроками»);
  # грядки — на краях дорожек, x2-контейнеры — в карманах флангов.
  # Нормы: 18 гексов (9/игрока); грядки 2+2 (= игрокам); у стартов 2+ свободных
  # соседа; свободные пути игрок-игрок: 2 (слева и справа от дыры).
